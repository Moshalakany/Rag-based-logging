{
  "LogSources": {
    "Sources": [
      {
        "Id": "TMS-app-log",
        "Type": "file",
        "Path": "sample-logs\\TMS.log",
        "SourceType": "TMS"
      },
      {
        "Id": "ocelot-gateway-log",
        "Type": "file",
        "Path": "sample-logs\\ocelot.log",
        "SourceType": "ocelot"
      },
      {
        "Id": "source-of-fund-log",
        "Type": "file",
        "Path": "sample-logs\\SourceOfFund.log",
        "SourceType": "source-of-fund"
      },
      {
        "Id": "acl-log",
        "Type": "file",
        "Path": "sample-logs\\ACL.log",
        "SourceType": "Anti-corruption-layer"
      },
      {
        "Id": "identity-log",
        "Type": "file",
        "Path": "sample-logs\\Identity.log",
        "SourceType": "Identity"
      }
    ]
  },
  "Parser": {
    "RegexRules": [
      {
        "Name": "syslog-like",
        "Pattern": "^(?<timestamp>\\w+\\s+\\d+\\s+\\d{2}:\\d{2}:\\d{2})\\s+\\S+\\s+(?<service_name>[\\w-]+)(?:\\[(?<Correlation_ID>[^\\]]+)\\])?:\\s+(?<severity>[A-Z]+)\\s+(?<message>.*)$"
      },
      {
        "Name": "acl-timestamped-json",
        "Pattern": "^(?<timestamp>\\d{4}-\\d{2}-\\d{2}\\s+\\d{2}\\s*:\\s*\\d{2}\\s*:\\s*\\d{2}\\.\\d+)\\s+\\{.*\"CorrelationId\"\\s*:\\s*\"(?<correlation_id>[a-fA-F0-9\\-]+)\".*\"Method\"\\s*:\\s*\"(?<method>[^\"]*)\".*\"Source\"\\s*:\\s*\"(?<service_name>[^\"]*)\".*\"MessageBody\"\\s*:\\s*(?<message_body>\\{[^}]*\\}).*\\}$"
      }
    ]
  },
  "Chunking": {
    "ChunkSizeTokens": 512,
    "OverlapTokens": 64
  },
  "Ingestion": {
    "ProcessingBatchSize": 256,
    "EnableNoiseFiltering": true,
    "DropRawPatterns": [
      "\\{\\\"PayloadSenderV2\\\"\\}\\s+Cancellation requested",
      "Elastic\\.Apm\\.Metrics\\.MetricSet"
    ],
    "EnableSourceCheckpoints": true,
    "CheckpointFilePath": "data\\ingestion-checkpoints.json"
  },
  "Scheduler": {
    "EnableDailyBatch": true,
    "EnableStreaming": false,
    "RunBatchOnStartup": false,
    "DailyBatchIntervalHours": 24,
    "StreamingPollSeconds": 30,
    "IngestionTimeWindowHours": 0
  },
  "Embedding": {
    "Provider": "ollama",
    "BaseUrl": "http://localhost:11434",
    "Model": "nomic-embed-text",
    "BatchSize": 64,
    "MaxParallelBatches": 2
  },
  "VectorStore": {
    "BaseUrl": "http://localhost:6333",
    "CollectionName": "log_chunks",
    "VectorSize": 768,
    "Distance": "Cosine",
    "RetentionDays": 30
  },
  "Retrieval": {
    "DefaultTopK": 8,
    "EnableHeuristicReranker": true
  },
  "Llm": {
    "Provider": "ollama",
    "BaseUrl": "http://localhost:11434",
    "Model": "llama3.2",
    "MaxHistoryMessages": 8,
    "SystemPrompt": "You are a log analyst assistant. Answer only from provided log context when it is relevant to the question. If the user asks a simple question about yourself (your name, greetings, capabilities), answer naturally without citing logs. Quote relevant entries with timestamps. Use natural language. If no matching logs are found, clearly state that."
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
