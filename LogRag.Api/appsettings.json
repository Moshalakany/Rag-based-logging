{
  "LogSources": {
    "Sources": [
      {
        "Id": "payments-app-log",
        "Type": "file",
        "Path": "sample-logs\\app.log",
        "SourceType": "app"
      },
      {
        "Id": "ocelot-gateway-log",
        "Type": "file",
        "Path": "sample-logs\\ocelot.log",
        "SourceType": "ocelot"
      },
      {
        "Id": "source-of-fund-log",
        "Type": "file",
        "Path": "sample-logs\\SourceOfFund.log",
        "SourceType": "source-of-fund"
      },
      {
        "Id": "acl-log",
        "Type": "file",
        "Path": "sample-logs\\ACL.log",
        "SourceType": "Anti-corruption-layer"
      }
    ]
  },
  "Parser": {
    "RegexRules": [
      {
        "Name": "syslog-like",
        "Pattern": "^(?<timestamp>\\w+\\s+\\d+\\s+\\d{2}:\\d{2}:\\d{2})\\s+\\S+\\s+(?<service_name>[\\w-]+)(?:\\[(?<Correlation_ID>[^\\]]+)\\])?:\\s+(?<severity>[A-Z]+)\\s+(?<message>.*)$"
      }
    ]
  },
  "Chunking": {
    "ChunkSizeTokens": 512,
    "OverlapTokens": 64
  },
  "Ingestion": {
    "ProcessingBatchSize": 256,
    "EnableNoiseFiltering": true,
    "DropRawPatterns": [
      "\\{\\\"PayloadSenderV2\\\"\\}\\s+Cancellation requested",
      "Elastic\\.Apm\\.Metrics\\.MetricSet"
    ],
    "EnableSourceCheckpoints": true,
    "CheckpointFilePath": "data\\ingestion-checkpoints.json"
  },
  "Scheduler": {
    "EnableDailyBatch": true,
    "EnableStreaming": false,
    "RunBatchOnStartup": false,
    "DailyBatchIntervalHours": 24,
    "StreamingPollSeconds": 30
  },
  "Embedding": {
    "BaseUrl": "http://localhost:11434",
    "Model": "nomic-embed-text",
    "BatchSize": 16,
    "MaxParallelBatches": 4
  },
  "VectorStore": {
    "BaseUrl": "http://localhost:6333",
    "CollectionName": "log_chunks",
    "VectorSize": 768,
    "Distance": "Cosine",
    "RetentionDays": 30
  },
  "Retrieval": {
    "DefaultTopK": 8,
    "EnableHeuristicReranker": true
  },
  "Llm": {
    "BaseUrl": "http://localhost:11434",
    "Model": "llama3.2",
    "MaxHistoryMessages": 8,
    "SystemPrompt": "You are a log analyst assistant. Answer only from provided log context. Quote relevant entries with timestamps. Use natural language. If no matching logs are found, clearly state that."
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
